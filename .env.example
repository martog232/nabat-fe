# When running behind Kong API Gateway (default — production parity):
#   VITE_API_BASE=http://localhost:8000
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# When running directly against nabat backend (skip Kong):
#   VITE_API_BASE=http://localhost:8080
#   VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: override WebSocket base URL when it differs from the API host
# If omitted, the frontend derives ws:// / wss:// automatically from VITE_API_BASE_URL
# VITE_WS_BASE=ws://localhost:8000
